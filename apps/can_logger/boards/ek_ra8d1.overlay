/*
 * App-local devicetree overlay for apps/can_logger on the EK-RA8D1.
 * Zephyr auto-applies <app>/boards/<board>.overlay by filename.
 *
 * Mirrors the project overlay D:/BITS_ASSIGNMENTS/ESD/SITUATIONAL_LEARNING/
 * boards/ek_ra8d1.overlay (kept in sync by hand) and additionally sets the
 * CAN-FD bitrates for this app.
 *
 * CANFD0 pins (see STATE.md "CANFD0 pin decision" + its RETRACTION for the
 * full rationale):
 *     CTX0 (CAN TX, MCU -> transceiver TXD) = P704
 *     CRX0 (CAN RX, transceiver RXD -> MCU) = P705
 * This is the Renesas FSP default pair, and matches the physical breadboard
 * wiring as built.
 *
 * The Phase 1 choice of P203/P202 is RETRACTED (2026-08-31): our part
 * R7FA8D1BHECBD (package PLBG0224GD-A) is the MIPI variant per datasheet
 * Table 1.13, so P202-P205 are permanently MIPI_CL_P/N + MIPI_DL0_P/N and
 * do not exist as GPIO/CANFD pins at all. The earlier "confirmation" read
 * the datasheet's "BGA224 without MIPI" column by mistake.
 *
 * TRADE-OFF ACCEPTED: P704/P705 are RMII0_RX_ER_B / RMII0_CRS_DV_B in the
 * board's ETHERNET-B mux and are bus-switch-routed to the Ethernet PHY in
 * hardware, so CAN-FD and on-chip Ethernet are mutually exclusive on this
 * board. Project decision: sequential use modes (capture over CAN, retrieve
 * over Ethernet afterwards), not simultaneous.
 *
 * Transceiver STB is hard-wired to GND (normal mode), so there is no
 * enable/standby GPIO entry here on purpose.
 */

#include <zephyr/dt-bindings/pinctrl/renesas/pinctrl-ra.h>

&pinctrl {
	/* Overrides the same-named node in
	 * zephyr/boards/renesas/ek_ra8d1/ek_ra8d1-pinctrl.dtsi; psels replaced.
	 *
	 * Encoding verified against pinctrl-ra.h:144 --
	 * RA_PSEL(psel,port,pin) = 1<<13 | psel<<8 | pin<<4 | port<<0,
	 * RA_PSEL_CANFD = 0x10. So P704 -> 0x3047, P705 -> 0x3057.
	 */
	canfd0_default: canfd0_default {
		group1 {
			/* CRX0 CTX0 */
			psels = <RA_PSEL(RA_PSEL_CANFD, 7, 5)>,   /* CRX0 -> P705 */
				<RA_PSEL(RA_PSEL_CANFD, 7, 4)>;   /* CTX0 -> P704 */
			drive-strength = "high";
		};
	};
};

&canfd0 {
	/* Arbitration phase 500 kbit/s, FD data phase 2 Mbit/s — common
	 * automotive CAN-FD rates and safely within any CAN-FD transceiver.
	 * Sample points left unset -> driver auto-selects (87.5% / 80% / 75%).
	 */
	bitrate = <500000>;
	bitrate-data = <2000000>;

	/* Passive external transceiver on the breadboard (STB tied to GND).
	 * max-bitrate documents the data-phase ceiling used for bitrate
	 * validation; tighten to the real transceiver datasheet once known.
	 */
	can-transceiver {
		max-bitrate = <5000000>;
	};
};
